// DK-14c.1 · Capability 资源化合约 v0.2.0（breaking，自 0.1.0 一次切换）
//
// # capability-token 归属（宿主权威）
//
// resource 定义在独立 `capability` 接口、经 world `import` 由**宿主实现**
// ——token 是宿主发放的不透明句柄（wasmtime ResourceTable，ty=宿主
// 类型），guest 侧仅持有 borrow 视图：不可伪造（表隔离）、不可解引用
// （无方法面）、不可转递（borrow 语义）。
//
// - 宿主发放：实例化时按 Manifest granted 集合快照构造（零权限插件不
//   发 token，invoke 直接拒 + [audit-host] 审计行）
// - 宿主校验：invoke 入口 token 有效性 + manifest 一致性；越权 →
//   CapabilityDenied + 审计行（docs/plugin-log-conventions.md）
//
// # 范围
// export host 接口无方法面扩展——guest 主动能力调用（token 消费，
// import 接口挂方法）属 14c 后续卡；UI 徽章/L1L2 细粒度属后续。
package aurora:plugin@0.2.0;

/// 能力令牌接口（宿主实现——resource 类型权威定义处）。
interface capability {
    /// 能力令牌：宿主发放的不透明句柄（L0 全有/全无 per-granted-set）。
    resource capability-token;

    /// 结构化日志（宿主转发 tracing，带 plugin_id 前缀）——token 显式
    /// borrow 参数（语义等价 resource 方法：句柄携带 rep，宿主经表 require）。
    /// L0 语义：granted 含 Log 才可调（per-method require）——
    /// 越权 CapabilityDenied + [audit-host] 审计行 reason=log-denied。
    /// 形态裁决（DK-14c.2→14c.3 修订）：自由函数而非 resource 方法
    /// （wit-bindgen 0.57.1 对 resource-method import 的组件生成实证
    /// 受阻）；level 用 string 而非 enum（同因）。14c.3 起宿主侧经
    /// bindgen 生成的 capability::Host trait 挂载（func_wrap 的
    /// ComponentNamedList 对单值/option/result 返回受阻——形态全自动）。
    log: func(token: borrow<capability-token>, level: string, msg: string);

    /// 读 KV（d2 docs 空间，全 runtime 共享——语义见文档）。不存在→空串
    /// （返回形态裁决：单值复合返回 option/result/list 经 wasmtime
    /// func_wrap ComponentNamedList（仅 tuple 实现）受阻，bindgen Host
    /// trait 的 HostWithStore/HasData 链与自定义 store-data 深耦合——
    /// 数据面统一 string 协议化，确定性优先，语义披露于文档）。
    read-doc: func(token: borrow<capability-token>, doc-id: string) -> string;
    /// 写 KV（data=JSON 序列化字符串；上限 1 MiB）。返回空串=ok；
    /// 非空=err message（协议化）。
    write-doc: func(token: borrow<capability-token>, doc-id: string, data: string) -> string;
    /// 键检索（doc-id contains 匹配，非内容搜索）。返回换行分隔键集
    /// （doc-id 约定不含换行）。
    query-docs: func(token: borrow<capability-token>, pattern: string) -> string;
}

interface host {
    use capability.{capability-token};

    /// 插件初始化（加载后调用一次）。
    init: func(capability: borrow<capability-token>) -> result;

    /// 宿主事件入口（宿主 → 插件事件通道）。
    handle-event: func(capability: borrow<capability-token>, event: string, payload: string) -> result;
}

/// 最小插件世界。
world plugin {
    import capability; // 宿主实现（token 权威）
    export host;       // guest 实现
}
