namespace aurora_mobile_ffi {
};

[Error]
enum MobileError {
    "InitFailed",
    "OperationFailed",
    "NotFound",
};

dictionary NoteSummary {
    string id;
    string title;
    string updated_at;
};

dictionary SearchResult {
    string note_id;
    string title;
    string snippet;
    double score;
};

interface UniffiAppCore {
    [Name=new, Throws=MobileError]
    constructor(string data_dir);

    [Throws=MobileError]
    string create_note(string title);

    sequence<NoteSummary> list_notes();

    // A-01（TA 22:12 工单）: DOCX/XLSX 包体导出（bytes;DoD 允许移动端只暴露导出）
    [Throws=MobileError]
    sequence<u8> export_note_docx(string note_id);

    [Throws=MobileError]
    sequence<u8> export_collection_xlsx(string collection_id);

    sequence<SearchResult> search_notes(string query);

    [Throws=MobileError]
    void delete_note(string note_id);
};
